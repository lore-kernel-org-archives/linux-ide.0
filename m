Highly scientific bash script used to test load average vs HD writes
(lol):
#!/bin/bash
declare -i i=3D0
#
declare TEST_DIR=3D/apps/test/
#
# TEST 1 (a lot of small files)
#declare -i MAX=3D100000
#declare BS=3D1024
#declare COUNT=3D1
#
# TEST 2 (a few 1mb files)
declare -i MAX=3D10000
declare BS=3D1024
declare COUNT=3D1024
#
# TEST 3 (a 1gb file)
declare -i MAX=3D10000
declare BS=3D1024
declare COUNT=3D1048576
#
while [ $i -lt $MAX ]
do
   declare TMP_FILE=3D`mktemp ${TEST_DIR}/${i}.XXXXXX` || exit 1
   dd if=3D/dev/zero of=3D${TMP_FILE} bs=3D${BS} count=3D${COUNT} =
2>/dev/null
   let i++
Done

