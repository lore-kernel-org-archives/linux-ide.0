>> +		__field( unsigned char,	hob_lbam )
>> +		__field( unsigned char,	hob_lbah )
>> +		__field( unsigned char,	hob_nsect )
>> +		__field( unsigned char,	hob_feature )
>> +		__field( unsigned char,	proto	)
